POSTGRES_PASSWORD=change_me_strong_password
ADMIN_TOKEN=change_me_long_random_admin_token

# Port on the HOST machine that forwards to the container's :8080. Change this if 8080
# is already used by something else on your server — e.g. HOST_PORT=8081.
HOST_PORT=8080

# Admin web panel (username/password + TOTP authenticator login at /panel/).
# Only needed on first deploy, to create the one-time bootstrap admin account.
# After logging in once and setting up TOTP, you can remove these two lines —
# they're only read when no admin account exists yet.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change_me_strong_password_too

TOTP_ISSUER=PushHub

# Set to "true" only once PushHub is served over HTTPS (domain + SSL via reverse proxy).
# Must stay "false" for plain-HTTP access by IP (e.g. http://192.168.x.x:8081), otherwise
# the browser will refuse to send the session cookie and login will appear to fail silently.
COOKIE_SECURE=false

# --- Email channel (POST /send/email) ---
# One hub-level SMTP account shared across every tenant, same model as the WA numbers
# (configured via the admin panel, not here). Leave all of these blank to disable the Email
# channel — /send/email will then return a clear "not configured" error instead of failing.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=notify@example.com
SMTP_PASSWORD=change_me
SMTP_FROM=notify@example.com
SMTP_FROM_NAME=Notification Hub
